# 火山方舟豆包大模型（人物性格对话推荐 Seed-1.6 / 1.5-Pro）
# 控制台：https://console.volcengine.com/ark → 创建推理接入点 → 复制 ep-xxx
# 方舟 API Key（与 export ARK_API_KEY 相同，二选一）
ARK_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LLM_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 在线推理接入点 https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint
LLM_MODEL=ep-xxxxxxxxxx-xxxxx
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=256
LLM_TOP_P=0.9

# 火山引擎豆包语音（新版控制台，仅需 API Key）
# 控制台：https://console.volcengine.com/speech → API Key 管理
DOUBAO_API_KEY=your-api-key-from-console
# 兼容旧变量名（与 DOUBAO_API_KEY 等价，二选一）
# DOUBAO_ACCESS_TOKEN=your-api-key-from-console
# 旧版应用管理（已废弃，仅作鉴权回退，新版勿填）
# DOUBAO_APP_ID=your-app-id
# 你的声音复刻音色 ID
DOUBAO_VOICE_TYPE=S_SUcfpOs32
DOUBAO_RESOURCE_ID=seed-tts-2.0
# 复刻音色（S_ 开头）自动使用此项，一般填 seed-icl-2.0
DOUBAO_CLONE_RESOURCE_ID=seed-icl-2.0
# 单向 HTTP cot 情感标签（复刻 2.0 表现力版，见 docs/doubao-tts-setup.md）
DOUBAO_USE_TAG_PARSER=true
DOUBAO_TTS_MODEL=seed-tts-2.0-expressive
DOUBAO_CLUSTER=volcano_tts

# 官方 emotion=sing 歌唱（仅 2.0 歌手音色如灿灿，与 S_ 复刻无关）
# DOUBAO_SING_ENABLED=true
# DOUBAO_SING_VOICE=zh_female_cancan_mars_bigtts
# DOUBAO_SING_RESOURCE_ID=seed-tts-2.0
# DOUBAO_SING_MODE=auto
# DOUBAO_SING_BPM=95
# DOUBAO_SING_EMOTION_SCALE=4

# SenseVoice（可选：设为 false 则 ASR 使用简易占位，便于无 GPU 环境调试）
ASR_ENABLED=true
ASR_MODEL=iic/SenseVoiceSmall

# 服务
HOST=0.0.0.0
# 8010 避免与 HBuilderX 内置服务（8000/8001）冲突
PORT=8010
PUBLIC_BASE_URL=http://192.168.43.102:8010
